# ==========================================
# PetFinder — Environment Variables Template
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ==========================================

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase Postgres + pgvector)
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-db-password
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543

# Supabase Storage (S3-compatible)
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_STORAGE_BUCKET_NAME=pet-images
AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=us-east-1

# Supabase Auth (สำหรับ frontend JS)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
